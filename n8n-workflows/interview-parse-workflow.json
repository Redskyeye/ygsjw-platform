            },
            {
              "name": "preferences",
              "value": {
                "language": "zh-CN",
                "depth": "comprehensive",
                "format": "slides",
                "timeframe": 7
              }
            }
          ]
        }
      },
      "id": "trigger-coaching",
      "name": "触发辅导生成",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1560, 400]
    },
    {
      "parameters": {
        "functionCode": "// 返回最终响应\nconst sessionId = $json.sessionId || $input.first().json.sessionId;\n\nreturn {\n  json: {\n    success: true,\n    sessionId: sessionId,\n    status: 'completed',\n    message: 'Interview parsing completed successfully',\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "final-response",
      "name": "最终响应",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1780, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "webhook-response",
      "name": "Webhook响应",
      "type": "n8n-nodes-base.webhookResponse",
      "typeVersion": 1,
      "position": [2000, 400]
    },
    {
      "parameters": {
        "functionCode": "// 错误处理\nconst error = $input.first().json;\n\nreturn {\n  json: {\n    success: false,\n    sessionId: error.sessionId || '',\n    status: 'failed',\n    error: {\n      code: 'WORKFLOW_ERROR',\n      message: error.message || 'Unknown error occurred'\n    },\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "error-handler",
      "name": "错误处理",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1340, 600]
    }
